{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 1800,
      "includeFiles": "{src/adproof/web/**,public/**}",
      "excludeFiles": "{tests/**,docs/**,scripts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/adproof-mark.svg"
    },
    {
      "source": "/examples",
      "destination": "/app"
    },
    {
      "source": "/examples.html",
      "destination": "/app"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/index.py"
    }
  ]
}
